.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Competition rasters/data are local only; this repository is public.
.cache/
data/
raw_parts/
*.tif
*.tiff
releases/*.tif
releases/*.tiff
!releases/.gitkeep

# Explicitly track derived zero-input-leakage binary GeoTIFF/ZIP submission
# deliverables served from GitHub Pages one-click download (IR90-44 / IR90-52).
# Raw competition input data (.cache/gems_data/) and releases/ remain ignored.
!docs/
!docs/downloads/
!docs/downloads/*.tif
!docs/downloads/*.zip
!docs/downloads/*.json
