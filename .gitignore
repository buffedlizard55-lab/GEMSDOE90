.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Competition rasters/data are local only; this repository is public.
.cache/
data/
raw_parts/
*.tif
*.tiff
releases/*.tif
releases/*.tiff
!releases/.gitkeep

# Explicitly track the tiny (132 KB) verified zero-input-leakage binary GeoTIFF
# and ZIP submission deliverable served by GitHub Pages one-click download:
!docs/
!docs/downloads/
!docs/downloads/*.tif
!docs/downloads/*.zip
!docs/downloads/*.json

